{"components/common/quick-search":"<div class=\"dropdown dropdown--quickSearch desktop\" id=\"quickSearch\" aria-hidden=\"true\" tabindex=\"-1\" data-prevent-quick-search-close>\r\n    <a href=\"#\" class=\"quickSearch-mobileToggle\" title=\"Submit Search\">\r\n        <span class=\"mobileMenu-toggleIcon\"></span>\r\n    </a>\r\n    <form class=\"form\" action=\"{{urls.search}}\">\r\n        <fieldset class=\"form-fieldset\">\r\n            <div class=\"form-field\">\r\n                <label class=\"is-srOnly\" for=\"search_query\">{{lang \"search.quick_search.input_label\"}}</label>\r\n                <input class=\"form-input\" data-search-quick name=\"search_query\" id=\"search_query\"\r\n                    data-error-message=\"{{lang 'search.error.empty_field'}}\"\r\n                    placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\r\n                    autocomplete=\"off\">\r\n            </div>\r\n        </fieldset>\r\n        <div class=\"search-icon submit\">\r\n            <button title=\"Submit Search\" class=\"button button--primary form-prefixPostfix-button--postfix\" type=\"submit\" value=\"{{lang 'search.quick_search.input_label'}}\">\r\n                <span class=\"material-icons\">search</span>\r\n                {{lang \"search.quick_search.input_label\"}}\r\n            </button>\r\n        </div>\r\n    </form>\r\n    <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\r\n</div>"}
