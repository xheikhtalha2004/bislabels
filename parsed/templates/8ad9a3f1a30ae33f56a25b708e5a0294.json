            </a>\r\n                            </p>\r\n                            \r\n                        </div>\r\n                    </article>\r\n                {{/if}}\r\n            </div>\r\n\r\n            {{#and theme_settings.shop_by_brand_show_footer shop_by_brand.length}}\r\n            <article class=\"footer-info-col footer-info-col--small tt-brands\" data-section-type=\"footer-brands\">\r\n              <h5 class=\"footer-info-heading\" style=\"margin-bottom:20px;\">{{lang 'footer.brands'}}</h5>\r\n                <ul class=\"footer-info-list\" style=\"list-style: none; padding: 0; margin: 0;\">\r\n                    {{#each shop_by_brand}}\r\n                        <li>\r\n                            <a href=\"{{url}}\">{{name}}</a>\r\n                        </li>\r\n                    {{/each}}\r\n                    <li><a href=\"{{urls.brands}}\">{{lang 'common.view_all'}}</a></li>\r\n                </ul>\r\n            </article>\r\n            {{/and}}\r\n\r\n             <article class=\"footer-payment tt-payment\" data-section-type=\"footer-payment\" style=\"width: 100%; text-align: center; margin-top: 20px;\">\r\n                {{> components/common/payment-icons}}\r\n            </article>\r\n\r\n       </section>\r\n        {{#if theme_settings.geotrust_ssl_common_name}}\r\n            <div class=\"footer-geotrust-ssl-seal\">\r\n                {{> components/common/geotrust-ssl-seal}}\r\n            </div>\r\n        {{/if}}\r\n        </div>       \r\n    </div>\r\n\r\n    <div class=\"social-copyright footer-bottom\">\r\n    \t<div class=\"container\">\r\n            {{#if theme_settings.social_icon_placement_bottom '!==' 'bottom_none'}}\r\n                <article class=\"footer-info-col\r\n                    footer-info-col--social\r\n                    footer-info-col--{{#if theme_settings.social_icon_placement_bottom '===' 'bottom_left'}}left{{else}}right{{/if}}\"\r\n                    data-section-type=\"footer-webPages\">\r\n                        <h5 class=\"footer-info-heading\">{{lang 'social.connect'}}</h5>\r\n                        {{> components/common/social-links}}\r\n                </article>\r\n            {{/if}}\r\n            \r\n            <div class=\"tt-copyright {{#if theme_settings.social_icon_placement_bottom '===' 'bottom_left'}}tt-right{{else}}tt-left{{/if}}\">\r\n            {{#if theme_settings.show_powered_by}}\r\n                <div class=\"footer-copyright\">\r\n                    <p class=\"powered-by\">Powered by BisLabels <a href=\"https://www.bigcommerce.com?utm_source=merchant&amp;utm_medium=poweredbyBC\" rel=\"nofollow\">BigCommerce</a></p>\r\n                </div>\r\n            {{/if}}\r\n            {{#if theme_settings.show_copyright_footer}}\r\n                <div class=\"footer-copyright\">\r\n                    <p class=\"powered-by\">&copy; {{moment format=\"YYYY\"}} {{settings.store_name}} </p>\r\n                </div>\r\n            {{/if}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</footer>\r\n\r\n\t<a href=\"#\" class=\"scrollToTop\" title=\"{{lang 'common.backtotop'}}\" style=\"display:none\"> \r\n\t\t<span class=\"material-icons\">keyboard_arrow_up</span>\r\n\t</a>\r\n \r\n<script>\r\n  $('.quickSearchResults').on('click', function() {\r\n    $('.quickSearchResults').fadeOut();\r\n  });\r\n  $(document).on('click', '.quickSearchResults .modal-close', function() {\r\n    $('.quickSearchResults').fadeOut();\r\n  });\r\n  $('.dropdown--quickSearch .form-input').on('click', function() {\r\n    $('.quickSearchResults').fadeIn();\r\n  });\r\n</script>","components/common/geotrust-ssl-seal":"<table width=\"135\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\" title=\"Click to Verify - This site chose GeoTrust SSL for secure e-commerce and confidential communications.\">\n    <tr>\n        <td width=\"135\" align=\"center\" valign=\"top\">\n            <script type=\"text/javascript\" src=\"https://seal.geotrust.com/getgeotrustsslseal?host_name={{theme_settings.geotrust_ssl_common_name}}&amp;size={{theme_settings.geotrust_ssl_seal_size}}&amp;lang={{locale_name}}\"></script><br />\n            <a href=\"http://www.geotrust.com/ssl/\" target=\"_blank\"  style=\"color:#000000; text-decoration:none; font:bold 7px verdana,sans-serif; letter-spacing:.5px; text-align:center; margin:0px; padding:0px;\"></a>\n        </td>\n    </tr>\n</table>\n","components/common/payment-icons":"{{#with theme_settings}}\r\n    {{#or show_accept_amex show_accept_discover show_accept_mastercard show_accept_paypal show_accept_visa show_accept_amazonpay show_accept_googlepay}}\r\n        <h5 class=\"footer-info-headings\">{{lang 'footer.payment-icon'}}</h5>\r\n    {{/or}}\r\n    {{#or show_accept_amex show_accept_discover show_accept_mastercard show_accept_paypal show_accept_visa show_accept_amazonpay show_accept_googlepay}}\r\n    <ul class=\"footer-payment-icons\">\r\n        {{#if show_accept_amex}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-american-express\"></use></svg></li>\r\n        {{/if}}\r\n        {{#if show_accept_discover}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-discover\"></use></svg></li>\r\n        {{/if}}\r\n        {{#if show_accept_mastercard}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-mastercard\"></use></svg></li>\r\n        {{/if}}\r\n        {{#if show_accept_paypal}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-paypal\"></use></svg></li>\r\n        {{/if}}\r\n        {{#if show_accept_visa}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-visa\"></use></svg></li>\r\n        {{/if}}\r\n        {{#if show_accept_amazonpay}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-amazonpay\"></use></svg></li>\r\n        {{/if}}\r\n        {{#if show_accept_googlepay}}\r\n        <li><svg class=\"footer-payment-icon\"><use xlink:href=\"#icon-logo-googlepay\"></use></svg></li>\r\n        {{/if}}\r\n    </ul>\r\n    {{/or}}\r\n{{/with}}\r\n","components/common/social-links":"{{#if social_media}}\r\n    <ul class=\"socialLinks socialLinks--alt\">\r\n        {{#each social_media}}\r\n            <li class=\"socialLinks-item\">\r\n                <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" title=\"{{name}}\" target=\"_blank\" rel=\"noopener\">\r\n                    <svg><use xlink:href=\"#icon-{{display_name}}\" /></svg>\r\n                    {{name}}\r\n                </a>\r\n            </li>\r\n        {{/each}}\r\n    </ul>\r\n{{/if}}\r\n","components/common/subscription-form":"<div class=\"newsletter-tittle\">\r\n    <h5 class=\"footer-info-headings\">\r\n        <span class=\"material-icons\">drafts</span>\r\n        {{lang 'newsletter.subscribe'}}\r\n    </h5>\r\n    <span class=\"newletter-desc\">{{lang 'newsletter.subscribe_intro'}}</span>\r\n</div>\r\n\r\n<div class=\"newsletter-contents\">\r\n    <form class=\"form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\r\n        <fieldset class=\"form-fieldset\">\r\n            <input type=\"hidden\" name=\"action\" value=\"subscribe\">\r\n            <input type=\"hidden\" name=\"nl_first_name\" value=\"bc\">\r\n            <input type=\"hidden\" name=\"check\" value=\"1\">\r\n            <div class=\"form-field\">\r\n                <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\r\n                <div class=\"form-prefixPostfix wrap\">\r\n                    <input class=\"form-input\" id=\"nl_email\" name=\"nl_email\" type=\"email\" value=\"{{customer.email}}\" placeholder=\"{{lang 'newsletter.email_placeholder'}}\">\r\n                    <input class=\"button button--default form-prefixPostfix-button--postfix\" type=\"submit\" value=\"{{lang 'newsletter.subscribe_submit'}}\" />\r\n                </div>\r\n                {{#if settings.show_newsletter_summary }}\r\n                    <div class=\"footer-newsletter-summary\">{{settings.newsletter_summary}}</div>\r\n                {{/if}}\r\n            </div>\r\n        </fieldset>\r\n    </form>\r\n</div>\n"}
