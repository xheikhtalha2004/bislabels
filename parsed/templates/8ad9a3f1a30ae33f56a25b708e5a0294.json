{"components/common/footer":"</script>\r\n\r\n<style>\r\n  .footer-info-col ul li a {\r\n    color: #ffffff !important;\r\n    transition: color 0.2s ease-in-out;\r\n  }\r\n  .footer-info-col ul li a:hover {\r\n    color: #e31b23 !important;\r\n  }\r\n  .footer-info {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: flex-start;\r\n    flex-wrap: wrap;\r\n    gap: 20px;\r\n  }\r\n  .footer-info-col {\r\n    flex: 1;\r\n    min-width: 200px;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n  }\r\n  .Contact_Detail p a.contact-link {\r\n    color: #ffffff !important;\r\n    text-decoration: none;\r\n    transition: color 0.2s ease-in-out;\r\n  }\r\n  .Contact_Detail p a.contact-link:hover {\r\n    color: #e31b23 !important;\r\n  }\r\n</style>\r\n\r\n<footer class=\"footer\" role=\"contentinfo\">\r\n\r\n\t<div class=\"tt-subscription\">\r\n    \t<div class=\"container\">\r\n            <article class=\"full-subscription\" data-section-type=\"newsletterSubscription\">\r\n                {{#if settings.show_newsletter_box}}\r\n                    {{> components/common/subscription-form}}\r\n                {{/if}}  \r\n            </article>\r\n        </div>\r\n    </div>\r\n\r\n     {{#if banners.bottom}}\r\n        <div class=\"bottom-banner\">\r\n       \t\t<div class=\"container\">\r\n\t\t\t\t<div class=\"banners\" data-banner-location=\"bottom\">\r\n\t\t\t\t\t<div class=\"banner\">\r\n\t\t\t\t\t\t{{{limit banners.bottom 1}}}\r\n\t\t\t\t\t</div>   \r\n\t\t\t\t</div>\r\n            </div>\r\n        </div>\r\n\t{{/if}}\r\n    \r\n    <div class=\"tt-footer-link\">\r\n        <div class=\"container\">\r\n        <section class=\"footer-info\">\r\n\r\n            <article class=\"footer-info-col footer-info-col--small tt-webPages\" data-section-type=\"footer-webPages\">\r\n              <h5 class=\"footer-heading\" style=\"color:white; font-family:Open Sans; font-weight:600; margin-bottom:15px;\">OUR COMPANY</h5>\r\n         